# Copy this file to ".streamlit/secrets.toml" and fill in your own values.
# secrets.toml is git-ignored. NEVER commit real keys or connection strings.
#
# On Streamlit Community Cloud paste the same keys into: App > Settings > Secrets.

# Supabase PostgreSQL connection string (Project Settings > Database > Connection string).
# Use the "Session pooler" or "Transaction pooler" string. Copy host AND user exactly as shown.
# The user is postgres.<project-ref> (one dot, 20-character ref, nothing else).
# Replace ONLY [YOUR-PASSWORD] with your database password; URL-encode special characters
# (@ -> %40, # -> %23, / -> %2F).
# Leave the placeholder (or remove the line) to fall back to a local SQLite file for development.
DATABASE_URL = "YOUR_SUPABASE_POSTGRESQL_CONNECTION_STRING"

GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "YOUR_CONFIGURED_GEMINI_MODEL"      # e.g. gemini-3.5-flash

# Optional
# GEMINI_FALLBACK_MODEL = "gemini-3.1-flash-lite"  # or "none" to disable
# APP_PASSWORD = "choose-a-long-passphrase"        # require a password before the app opens (recommended when public)
# OCR_LANGUAGES = "eng"
# DATABASE_AUTO_MIGRATE = "true"                   # apply supabase/migrations automatically on start
